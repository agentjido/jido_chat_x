# Copy this file to `.env` and fill in real values.
# Never commit `.env`; it is ignored by git.
#
# `test/test_helper.exs` loads `.env` and `.env.test` with Dotenvy before
# tests run. Live tests stay excluded unless you explicitly include them:
#
#   mix test --include live

# Enable live X tests. Leave false for normal local test runs.
RUN_LIVE_X_TESTS=false

# Enable live send tests. This creates real DMs, so leave false until you are
# ready to send to X_TEST_RECIPIENT_ID.
RUN_LIVE_X_SEND_TESTS=false

# OAuth 1.0a user-context credentials for XDK Direct Messages.
# The authenticated user must have permission to send DMs.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional app-only bearer token, if you want to build app-context tests later.
X_BEARER_TOKEN=

# Numeric X user id that the authenticated account can DM.
# The live send test uses this as the outbound room id.
X_TEST_RECIPIENT_ID=

# Optional existing DM conversation id for manual fetch/history checks.
# Use without the `conversation:` prefix here.
X_TEST_CONVERSATION_ID=

# Account Activity / webhook setup values for runtime integration.
X_WEBHOOK_ID=
X_WEBHOOK_URL=
X_WEBHOOK_ENV_NAME=

# Optional compatibility alias for Account Activity CRC/signature checks.
# If unset, the adapter uses X_CONSUMER_SECRET.
SECRET_KEY=
